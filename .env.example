# Root .env example (optional). Backend loads this file automatically.

# YouTube Data API v3 (backend) — free API key, no premium account required.
# Create one in Google Cloud Console → APIs & Services → Credentials → API key,
# with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=your_youtube_api_key

# Frontend origin(s) allowed by FastAPI CORS (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Frontend runtime config
REACT_APP_API_BASE_URL=http://localhost:8756
