# YouTube Data API v3 integration — free API key, no premium account required.
# Create one in Google Cloud Console → APIs & Services → Credentials → API key,
# with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=your_youtube_api_key

# Comma-separated list of allowed frontend origins for CORS
# Local dev default is already handled in code, but set this in production.
BACKEND_CORS_ORIGINS=https://your-frontend.vercel.app
